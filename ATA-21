const content=document.getElementById("content"), lists={};
for(const ch of ["21-31","21-62"]){const group=entries.filter(x=>x.ch===ch);const heading=document.createElement("div");heading.className="section-title";const h=document.createElement("h2");h.textContent=ch==="21-31"?"ATA 21-31 · Cabin Pressurization Control":"ATA 21-62 · Pack/Zone Temperature Control";const count=document.createElement("span");count.textContent=group.length+" message entries";heading.append(h,count);content.appendChild(heading);const list=document.createElement("div");list.className="fault-list";content.appendChild(list);lists[ch]=list;
for(const item of group){const card=document.createElement("details");card.className="fault";card.dataset.search=Object.values(item).filter(v=>typeof v==="string").join(" ").toLowerCase();const summary=document.createElement("summary");const name=document.createElement("span");name.className="fault-name";name.textContent=item.msg;const badge=document.createElement("span");badge.className="task-badge";badge.textContent=item.ch+" · Task "+item.task;summary.append(name,badge);card.appendChild(summary);const fields=document.createElement("div");fields.className="fields";for(const [key,label] of labels){const box=document.createElement("section");box.className="field";const title=document.createElement("h3");title.textContent=label;const text=document.createElement("p");text.textContent=String(item[key]).replace(/;\s*/g,"\n");box.append(title,text);fields.appendChild(box);}card.appendChild(fields);const figures=figureSets[`${item.ch}:${item.task}`];if(figures){const gallery=document.createElement("details");gallery.className="figure-gallery";const galleryTitle=document.createElement("summary");galleryTitle.textContent=`FIM Figures · ${figures.length} ${figures.length===1?"page":"sheets"}`;const grid=document.createElement("div");grid.className="figure-grid";for(const figure of figures){const link=document.createElement("a");link.className="figure-link";link.href=figure.src;link.target="_blank";link.rel="noopener";link.setAttribute("aria-label",`${figure.label} (opens full size)`);const img=document.createElement("img");img.src=figure.src;img.alt=figure.alt;img.loading="lazy";const caption=document.createElement("span");caption.textContent=figure.label;link.append(img,caption);grid.appendChild(link);}gallery.append(galleryTitle,grid);card.appendChild(gallery);}list.appendChild(card);}}
const cards=[...document.querySelectorAll("details.fault")], search=document.getElementById("search"), count=document.getElementById("count");
function filter(){const q=search.value.trim().toLowerCase();let visible=0;for(const card of cards){card.hidden=!!q&&!card.dataset.search.includes(q);if(!card.hidden)visible++;}count.textContent=visible+" of "+cards.length+" message entries";}
search.addEventListener("input",filter);document.getElementById("expand").addEventListener("click",()=>cards.filter(c=>!c.hidden).forEach(c=>c.open=true));document.getElementById("collapse").addEventListener("click",()=>cards.forEach(c=>c.open=false));
</script>
</body>
</html>
